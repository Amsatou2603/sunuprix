# URL de base de l'API backend SunuPrix (sans slash final).
# En développement local :
NEXT_PUBLIC_API_URL="http://localhost:4000"
# En production (Vercel), utiliser l'URL du backend déployé sur Render, ex :
# NEXT_PUBLIC_API_URL="https://sunuprix-api.onrender.com"

# --- Connexion avec Google (Google Identity Services) -----------------------
# Optionnelle : en son absence, le bouton "Continuer avec Google" reste
# affiché mais désactivé. Client ID OAuth 2.0 créé dans Google Cloud Console
# — PAS un secret (visible dans le navigateur par construction), doit être
# identique à GOOGLE_CLIENT_ID côté backend (backend/.env.example).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
