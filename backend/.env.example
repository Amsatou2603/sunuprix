# --- Base de données ---------------------------------------------------
# Chaîne de connexion PostgreSQL Neon.
#
# En LOCAL : la connexion directe suffit (hôte sans suffixe "-pooler") :
#   postgresql://user:password@ep-example-000000.eu-central-1.aws.neon.tech/sunuprix?sslmode=require
#
# En PRODUCTION (Render) : utiliser impérativement la variante "pooled" de
# Neon (bouton "Pooled connection" dans le tableau de bord Neon), reconnaissable
# à son hôte se terminant par "-pooler", et ajouter `&pgbouncer=true` pour que
# Prisma désactive les "prepared statements" (incompatibles avec PgBouncer en
# mode transaction) :
DATABASE_URL="postgresql://user:password@ep-example-000000-pooler.eu-central-1.aws.neon.tech/sunuprix?sslmode=require&pgbouncer=true"

# --- Authentification ----------------------------------------------------
# Secret utilisé pour signer les JWT. À remplacer par une valeur longue et
# aléatoire en production (ex: `openssl rand -base64 48`).
JWT_SECRET="changez-moi-avec-une-valeur-longue-et-aleatoire"
# Durée de validité des tokens émis (format accepté par la librairie jsonwebtoken).
JWT_EXPIRES_IN="7d"
# Nombre de "rounds" bcrypt pour le hachage des mots de passe.
BCRYPT_SALT_ROUNDS=10

# --- Serveur ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origine(s) autorisée(s) en CORS pour le frontend, séparées par des virgules.
# En développement : http://localhost:3000
# En production : l'URL Vercel du frontend déployé.
CORS_ORIGIN="http://localhost:3000"

# --- Chatbot -----------------------------------------------------------
# Optionnelle : en son absence (ou si l'appel échoue), un mode de repli local
# ancré sur les mêmes données réelles est utilisé automatiquement — jamais
# d'erreur visible pour l'utilisateur.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
